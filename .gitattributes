# Windows-only: checkout CRLF, commit LF
* text=auto eol=crlf

# Unity YAML/assets giữ LF để tránh Unity serialize lại / diff rác
*.unity text eol=lf
*.prefab text eol=lf
*.meta text eol=lf
*.asset text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.mat text eol=lf
*.inputactions text eol=lf
*.cginc text eol=lf
*.shader text eol=lf

# Code giữ CRLF trên Windows
*.cs text diff=csharp eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf
*.json text eol=crlf
*.xml text eol=crlf
*.md text eol=crlf

# Binary Unity
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.dll binary
*.exe binary
